# =============================================================
# VinhUni Backend — mẫu cấu hình
# =============================================================
# Cách dùng:  cp .env.example .env  rồi điền giá trị thật.
# Tệp .env KHÔNG BAO GIỜ được commit (đã chặn trong .gitignore).
# Tệp .env.example này thì NÊN commit, nhưng chỉ chứa giá trị giả.
# =============================================================

# --- Môi trường ------------------------------------------------
APP_ENV=production
APP_BASE_URL=https://mobi.vinhuni.edu.vn
CORS_ALLOWED_ORIGINS=https://mobi.vinhuni.edu.vn,https://admin.mobi.vinhuni.edu.vn

# --- Cơ sở dữ liệu SQL Server ----------------------------------
DB_DRIVER=ODBC Driver 17 for SQL Server
DB_SERVER=MAY_CHU\TEN_INSTANCE
DB_NAME=VinhUni_Local
DB_USER=dien_tai_khoan
DB_PASSWORD=dien_mat_khau
DB_TRUST_SERVER_CERT=true

# --- Đăng nhập Office 365 (Azure AD) ---------------------------
# Lấy tại: portal.azure.com > App registrations > VinhUni App
MS_CLIENT_ID=00000000-0000-0000-0000-000000000000
MS_CLIENT_SECRET=dien_client_secret
MS_TENANT_ID=00000000-0000-0000-0000-000000000000
MS_REDIRECT_URI=https://mobi.vinhuni.edu.vn/office365_login

# --- Bảo mật ---------------------------------------------------
# Sinh chuỗi ngẫu nhiên:  python -c "import secrets;print(secrets.token_urlsafe(48))"
SESSION_SECRET_KEY=dien_chuoi_ngau_nhien_dai
JWT_SECRET_KEY=dien_chuoi_ngau_nhien_khac
JWT_ALGORITHM=HS256
JWT_TTL_MINUTES=720
JWT_REFRESH_TTL_DAYS=30
FIREBASE_CREDENTIALS_PATH=vinhuni-portal-firebase-adminsdk.json

# --- Trợ lý AI -------------------------------------------------
OPENAI_API_KEY=sk-dien_khoa_that
AI_CHAT_MODEL=gpt-4o-mini
AI_EMBEDDING_MODEL=text-embedding-3-small
# Ngưỡng an toàn (core/ai_guard.py)
AI_MAX_PROMPT_CHARS=4000
AI_MAX_REQUESTS_PER_HOUR=60
AI_REQUIRE_CITATION=true
# Chỉ bật khi cần gỡ lỗi, và phải xoá nhật ký sau khi xong
AI_LOG_PROMPTS=false

# --- Ký số văn bản và hồ sơ dịch vụ công -----------------------
# Chọn MỘT trong ba phương thức dưới đây.
#
# (A) Thiết bị ký số / HSM cắm tại máy chủ — khuyến nghị cho ký số tổ chức
SIGN_PKCS11_LIB=
SIGN_PKCS11_PIN=
SIGN_PKCS11_TOKEN_LABEL=
#
# (B) Chứng thư dạng tệp .pfx — CHỈ dùng cho môi trường thử nghiệm
SIGN_PFX_PATH=
SIGN_PFX_PASSWORD=
#
# (C) Ký số từ xa qua nhà cung cấp dịch vụ chứng thực (VNPT-CA, Viettel-CA, MISA eSign...)
SIGN_REMOTE_URL=
SIGN_REMOTE_API_KEY=

# Dịch vụ cấp dấu thời gian — BẮT BUỘC để chữ ký còn giá trị sau khi
# chứng thư hết hạn (chuẩn PAdES-LTV, theo Nghị định 130/2018/NĐ-CP)
SIGN_TSA_URL=http://tsa.vnpt-ca.vn/timestamp
SIGN_TSA_USERNAME=
SIGN_TSA_PASSWORD=

SIGN_STORAGE_DIR=signed_documents

# --- Dịch vụ nội bộ --------------------------------------------
INTERNAL_STUDENT_AI=http://127.0.0.1:8011/internal/verify_student
IMAGE_FOLDER=vneid_images

# --- CSDL hồ sơ cán bộ (máy chủ riêng) ---
STAFF_DB_SERVER=
STAFF_DB_NAME=DBHoSoCanBo
STAFF_DB_USER=
STAFF_DB_PASSWORD=

# --- Bộ đồng bộ (sync_and_notify_worker_new.py) ---
WEATHER_API_KEY=
STAFF_LINKED_SERVER=172.16.0.26\\vinhuni

# --- Siết xác thực cho các endpoint thông báo ---
# false = bản ứng dụng cũ (không gửi token) vẫn dùng được, chỉ ghi nhật ký cảnh báo
# true  = bắt buộc có token; chỉ bật SAU KHI bản ứng dụng mới đã phủ hết máy người dùng
REQUIRE_AUTH_NOTIFS=false

# --- Tài khoản chỉ-đọc cho trợ lý AI (tuỳ chọn) ---
# Khai để trợ lý dùng tài khoản riêng chỉ có quyền SELECT, thay vì tài khoản
# chung. Bỏ trống thì dùng tài khoản ở DB_USER/DB_PASSWORD.
CHATBOT_DB_USER=
CHATBOT_DB_PASSWORD=
